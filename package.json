{
  "name": "doorbell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "bun test src",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:local": "wrangler d1 migrations apply doorbell --local",
    "db:remote": "wrangler d1 migrations apply doorbell --remote",
    "smoke": "bun scripts/smoke.ts",
    "lighthouse": "lhci autorun",
    "deploy": "bun run build && bun run db:remote && wrangler deploy && bun run lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@lhci/cli": "^0.16.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
