{
  "name": "doorbell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "bun test src",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:local": "wrangler d1 migrations apply doorbell --local",
    "smoke": "bun scripts/smoke.ts",
    "check:model": "bun scripts/check-model.ts",
    "lighthouse": "lhci autorun",
    "db:staging": "wrangler d1 migrations apply doorbell-staging --remote --env staging",
    "db:live": "wrangler d1 migrations apply doorbell --remote",
    "smoke:staging": "bun scripts/smoke.ts https://doorbell-staging.kumarbharath63.workers.dev",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && bun run db:staging && wrangler deploy",
    "deploy:live": "vite build && bun run db:live && wrangler deploy && bun run lighthouse",
    "seed:local": "bun scripts/seed.ts local",
    "seed:staging": "bun scripts/seed.ts staging"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hono": "^4.13.16",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@lhci/cli": "^0.16.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
